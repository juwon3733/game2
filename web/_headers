# Cloudflare Pages 응답 헤더 (GitHub Pages는 이 파일을 무시한다)
# 코드는 배포하면 바로 바뀌게, 그림·소리는 하루 동안 브라우저에 둔다(같은 파일명으로 교체될 수 있어서 길게 두지 않는다)
/*
  X-Content-Type-Options: nosniff
/*.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=2592000
